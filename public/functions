    <script>
      var codeLines = [];
      codeLines.push('');codeLines.push('function plus(a, b) {\u000A');codeLines.push('    return a + b;\u000A}\u000A');codeLines.push('let res \u003D plus(1, 2)\u000Aconsole.log(\"1+2 \u003D\", res);\u000A');codeLines.push('res \u003D plus(\"foo\", \"bar\");\u000Aconsole.log(\"foo+bar\u003D\", res);\u000A');codeLines.push('function plusPlus(a, b, c \u003D 5) {\u000A    return a + b + c\u000A}\u000A');codeLines.push('res \u003D plusPlus(1, 2, 3);\u000Aconsole.log(\"1+2+3 \u003D\", res);\u000A');codeLines.push('res \u003D plusPlus(1, 2);\u000Aconsole.log(\"1+2+5\u003D\", res);\u000A');codeLines.push('hello();\u000A');codeLines.push('function hello() {\u000A    console.log(\"Hello\");\u000A}\u000A');codeLines.push('const greet \u003D function(name) {\u000A    console.log(\"Howdy,\", name);\u000A}\u000Agreet(\"Chosen Undead\");\u000A');codeLines.push('const print \u003D (parameter) \u003D\u003E {\u000A    console.log(parameter);\u000A}\u000A');codeLines.push('function printAll() {\u000A    console.log(arguments);\u000A}\u000AprintAll(\"a\", \"b\", \"c\");\u000A');codeLines.push('function restParams(one, two, ...rest) {\u000A    console.log(one, two);\u000A    console.log(\"rest:\", rest);\u000A}\u000ArestParams(\"a\", \"b\", \"c\", \"d\");\u000A');codeLines.push('');
    </script>
