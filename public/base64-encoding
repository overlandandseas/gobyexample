    <script>
      var codeLines = [];
      codeLines.push('');codeLines.push('const encodedData \u003D btoa(\"Hello World\");\u000Aconsole.log(encodedData);\u000A');codeLines.push('const decodedData \u003D atob(encodedData);\u000Aconsole.log(decodedData);\u000A');codeLines.push('const bufferObj \u003D Buffer.from(\"Howdy Friends\", \"utf8\");\u000A');codeLines.push('const base64String \u003D bufferObj.toString(\"base64\");\u000A');codeLines.push('console.log(base64String);\u000A');codeLines.push('const encodedBuffer \u003D Buffer.from(base64String, \"base64\");\u000A');codeLines.push('const decodedString \u003D encodedBuffer.toString(\"utf8\");\u000Aconsole.log(decodedString);\u000A');codeLines.push('');
