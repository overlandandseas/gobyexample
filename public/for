    <script>
      var codeLines = [];
      codeLines.push('');codeLines.push('for (let i \u003D 1; i \u003C\u003D 3; i++) {\u000A    console.log(i);\u000A}\u000A');codeLines.push('let i \u003D 1;\u000Afor (; i \u003C 3; i++) {\u000A  console.log(i);\u000A}\u000A');codeLines.push('let a \u003D 0;\u000Awhile (a \u003C\u003D 3) {\u000A  console.log(\'while\', a);\u000A  a++;\u000A}\u000A');codeLines.push('let b \u003D 0;\u000Ado {\u000A    console.log(\'do-while\', b);\u000A    b++;\u000A} while (b % 2 !\u003D\u003D 0);\u000A');codeLines.push('let object \u003D { a: 1, b: 2, c: 3 };\u000Afor (let property in object) {\u000A  console.log(`${property}: ${object[property]}`);\u000A}\u000A');codeLines.push('let array \u003D [\"a\", \"b\", \"c\"];\u000Afor (let element of array) {\u000A  console.log(element);\u000A}\u000A');codeLines.push('');
