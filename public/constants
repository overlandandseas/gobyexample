    <div class="example" id="constants">
      <h2><a href="./">Node.js by Example</a>: Constants</h2>
      
      <table>
        
        <tr>
          <td class="docs">
            <p>Javascript supports <em>constants</em> of primative values.
They cannot be reassigned.</p>

          </td>
          <td class="code empty leading">
            
          
          </td>
        </tr>
        
        <tr>
          <td class="docs">
            <p><code>const</code> declares a constant value.</p>

          </td>
          <td class="code leading">
            
          <pre class="chroma"><code><span class="line"><span class="cl"><span class="kr">const</span> <span class="nx">s</span> <span class="o">=</span> <span class="s2">&#34;constant&#34;</span><span class="p">;</span>
</span></span><span class="line"><span class="cl"><span class="kr">const</span> <span class="nx">n</span> <span class="o">=</span> <span class="mi">5000000000</span><span class="p">;</span></span></span></code></pre>
          </td>
        </tr>
        
        <tr>
          <td class="docs">
            <p>constants cannot be reassigned.</p>

          </td>
          <td class="code">
            
          <pre class="chroma"><code><span class="line"><span class="cl"><span class="kr">const</span> <span class="nx">a</span> <span class="o">=</span> <span class="s2">&#34;foo&#34;</span><span class="p">;</span>
</span></span><span class="line"><span class="cl"><span class="nx">a</span> <span class="o">=</span> <span class="s2">&#34;bar&#34;</span><span class="p">;</span></span></span></code></pre>
          </td>
        </tr>
        
      </table>
      
      <table>
        
        <tr>
          <td class="docs">
            
          </td>
          <td class="code leading">
            
          <pre class="chroma"><code><span class="line"><span class="cl"><span class="gp">$</span> node constant.js 
</span></span><span class="line"><span class="cl"><span class="go">a = &#34;bar&#34;;
</span></span></span><span class="line"><span class="cl"><span class="go">  ^</span></span></span></code></pre>
          </td>
        </tr>
        
        <tr>
          <td class="docs">
            
          </td>
          <td class="code">
            
          <pre class="chroma"><code><span class="line"><span class="cl"><span class="go">TypeError: Assignment to constant variable.</span></span></span></code></pre>
          </td>
        </tr>
        
