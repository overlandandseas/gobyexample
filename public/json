    <script>
      var codeLines = [];
      codeLines.push('');codeLines.push('let json \u003D JSON.stringify(\"bare string\");\u000Aconsole.log(json);\u000A');codeLines.push('json \u003D JSON.stringify([1, 2]);\u000Aconsole.log(json);\u000A');codeLines.push('json \u003D JSON.stringify({ name: \"John\" });\u000Aconsole.log(json);\u000A');codeLines.push('json \u003D JSON.stringify({ name: \"Sarah\" }, 4, 4);\u000Aconsole.log(json);\u000A');codeLines.push('json \u003D JSON.stringify({\u000A    name: null,\u000A    occupation: undefined,\u000A    title: \"Engineer\"\u000A});\u000Aconsole.log(json);\u000A');codeLines.push('let obj \u003D JSON.parse(\u000A    \'{\"name\": \"Frank\", \"favoriteFood\": \"Tacos\"}\'\u000A);\u000Aconsole.log(\"obj.name\", obj.name);\u000A');codeLines.push('');
    </script>
    <script src="site.js" async></script>
  </body>
