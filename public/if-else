    </p>

    </div>
    <script>
      var codeLines = [];
      codeLines.push('');codeLines.push('if (7 % 2 \u003D\u003D\u003D 0) {\u000A    console.log(\"7 is even\");\u000A} else {\u000A    console.log(\"7 is odd\");\u000A}\u000A');codeLines.push('if (8 % 4 \u003D\u003D\u003D 0) {\u000A    console.log(\"8 is divisible by 4\");\u000A}\u000A');codeLines.push('if (8 % 2 \u003D\u003D\u003D 0 || 7 % 2 \u003D\u003D\u003D 0) {\u000A    console.log(\"either 8 or 7 are even\");\u000A}\u000A');codeLines.push('if (5 \u003C 3)\u000A    console.log(\"5 is less than 3\");\u000Aelse\u000A    console.log(\"5 is not less than three\");\u000A');codeLines.push('let a \u003D 9 % 2 \u003D\u003D\u003D 0 ? \"even\" : \"odd\";\u000Aconsole.log(a);\u000A');codeLines.push('');
    </script>
    <script src="site.js" async></script>
  </body>
</html>
